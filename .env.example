# Porta do servidor HTTP
PORT=3000

# true = substitui WaSenderAPI, Whisper, Anthropic, Supabase e ONE por stubs locais
MOCK_EXTERNAL=false

# WaSenderAPI (WhatsApp não-oficial)
WASENDER_API_KEY=
WASENDER_WEBHOOK_SECRET=

# Anthropic (interpretação de linguagem natural)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# OpenAI (transcrição de áudio via Whisper)
OPENAI_API_KEY=

# Supabase do app ONE (service role)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# App ONE (Lovable)
ONE_APP_URL=
WHATSAPP_SERVICE_SECRET=

# Job de avisos diários
AVISO_HORARIO_PADRAO=08:00
TZ_AVISOS=America/Sao_Paulo
