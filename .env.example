# Porta do servidor HTTP
PORT=3000

# true = substitui WaSenderAPI, OpenAI e ONE por stubs locais
MOCK_EXTERNAL=false

# WaSenderAPI (WhatsApp não-oficial)
WASENDER_API_KEY=
WASENDER_WEBHOOK_SECRET=

# OpenAI (transcrição Whisper + interpretação das mensagens)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# App ONE (Lovable) — se omitida usa https://onedashboard.app
# ONE_APP_URL=
WHATSAPP_SERVICE_SECRET=

# Fuso do job de avisos diários
TZ_AVISOS=America/Sao_Paulo
